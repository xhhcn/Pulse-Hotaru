# Dependencies
node_modules/

# Build outputs
dist/
.astro/
coverage/

# Compiled binaries
# Server binaries are built locally during development / by CI and NOT
# committed to the repo (the CI workflow uploads them to GitHub Release
# artifacts instead — see .github/workflows/docker.yml).
server/probe-server
server/probe-server.exe
server/pulse-server-standalone
server/pulse-server-standalone-linux-amd64
server/pulse-server-standalone-linux-arm64
# Client binaries are not committed here: Pulse-Hotaru ships only the
# server, and client/install.sh downloads the agent from xhhcn/Pulse
# (whose CI rebuilds and commits them on every client change).
client/probe-client
client/probe-client-arm64
client/probe-client-darwin-amd64
client/probe-client-darwin-arm64
client/probe-client.exe

# Database and data files
*.db
*.db-journal
data/
!server/web/src/data/
!server/web/src/data/*.ts

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Environment files
.env
.env.local
.env.*.local

# Docker artifacts (keep Dockerfile and docker-compose)
.docker/

# Temporary files
tmp/
temp/
*.tmp

# Sensitive files - NEVER commit these
*recovery-codes*
*secret*
*password*
*.key
*.pem
*.p12
*.pfx
